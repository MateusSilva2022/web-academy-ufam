generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Autor {
  id               Int      @id @default(autoincrement())
  nome             String
  dataNascimento   DateTime
  paisNascimento   String
  biografia        String?

  livros           LivroAutor[]
}

model Livro {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  nome      String
  lingua    String
  ano       Int

  autores   LivroAutor[]
  edicoes   Edicao[]
}

model LivroAutor {
  livroId Int
  autorId Int

  livro Livro @relation(fields: [livroId], references: [id])
  autor Autor @relation(fields: [autorId], references: [id])

  @@id([livroId, autorId])
}

model Editora {
  id        Int      @id @default(autoincrement())
  nome      String
  endereco  String
  telefone  String

  edicoes   Edicao[]
}

model Edicao {
  id                 Int      @id @default(autoincrement())
  isbn               String   @unique
  preco              Float
  ano                Int
  numeroPaginas      Int
  quantidadeEstoque  Int

  livroId    Int
  editoraId  Int

  livro     Livro   @relation(fields: [livroId], references: [id])
  editora   Editora @relation(fields: [editoraId], references: [id])
}